# =============================================================================
# Read-Only Data Warehouse Connection Configuration
# Copy this file to `.env` and fill in your read-only credentials.
# NEVER commit `.env` to version control.
# =============================================================================

# Option A: Full SQLAlchemy connection URI (takes precedence if set)
# Examples:
#   PostgreSQL / Yellowbrick: postgresql+psycopg2://ro_user:password@host:5432/dbname?sslmode=require
#   SQLite (local dev):       sqlite:///./sample.db
#   SQL Server:               mssql+pyodbc://ro_user:password@host:1433/dbname?driver=ODBC+Driver+17+for+SQL+Server
#   Snowflake:                snowflake://ro_user:password@account/dbname/schema?warehouse=WH&role=RO_ROLE
#   MySQL:                    mysql+pymysql://ro_user:password@host:3306/dbname
DATABASE_URL=

# Option B: Discrete connection parameters (used if DATABASE_URL is empty)
DB_DIALECT=postgresql
DB_DRIVER=psycopg2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=analytics
DB_SCHEMA=public
DB_USER=readonly_user
DB_PASSWORD=
DB_SSLMODE=prefer

# Safety & Execution Guardrails
DB_QUERY_TIMEOUT_SECONDS=60
DB_MAX_ROWS=100000
DB_READ_ONLY_ENFORCED=true
